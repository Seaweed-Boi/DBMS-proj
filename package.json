{
  "name": "drrms",
  "version": "1.0.0",
  "private": true,
  "description": "Disaster Relief Resource Management System — PostgreSQL + Redis DBMS project",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed && tsx scripts/redis-rebuild.ts",
    "redis:rebuild": "tsx scripts/redis-rebuild.ts",
    "test:concurrency": "tsx scripts/concurrency-test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.11.1",
    "next": "^15.5.29",
    "next-auth": "^4.24.15",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.5.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
